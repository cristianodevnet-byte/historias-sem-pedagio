// Configuração de publicação na Cloudflare (Workers com arquivos estáticos).
// O site é 100% estático: a Cloudflare só serve o conteúdo da pasta dist,
// gerada por `npm run build`. Não há código rodando no servidor.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "historias-sem-pedagio",
  "compatibility_date": "2026-10-01",
  // Endereço público: https://historias-sem-pedagio.sempedagio.workers.dev (o do QR Code).
  "workers_dev": true,
  // Endereços de teste para outros branches; a página principal não é afetada.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Qualquer endereço desconhecido abre a página inicial (a história do dia).
    "not_found_handling": "single-page-application"
  }
}
