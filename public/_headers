# Cabeçalhos HTTP aplicados pela Cloudflare aos arquivos do site.
# Arquivos em /assets têm nome com hash e podem ficar em cache por um ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# A página precisa ser sempre revalidada, para a história do dia aparecer logo após cada publicação.
/
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
